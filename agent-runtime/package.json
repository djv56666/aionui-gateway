{
  "name": "aionui-agent-runtime",
  "version": "1.0.0",
  "description": "AionUI Agent Runtime with Sidecar and ACP Bridge",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "dev": "tsx watch index.js",
    "build:opencode": "docker build -t aionui-runtime-opencode:latest -f images/opencode/Dockerfile .",
    "build:claude": "docker build -t aionui-runtime-claude:latest -f images/claude/Dockerfile .",
    "build:codex": "docker build -t aionui-runtime-codex:latest -f images/codex/Dockerfile .",
    "build:goose": "docker build -t aionui-runtime-goose:latest -f images/goose/Dockerfile .",
    "build:openclaw": "docker build -t aionui-runtime-openclaw:latest -f images/openclaw/Dockerfile .",
    "build:all": "npm run build:opencode && npm run build:claude && npm run build:codex && npm run build:goose && npm run build:openclaw"
  },
  "dependencies": {
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.2",
    "node-cron": "^3.0.3",
    "ws": "^8.20.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "tsx": "^4.6.0",
    "typescript": "^5.3.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "keywords": [
    "aionui",
    "agent",
    "runtime",
    "sidecar",
    "acp-bridge",
    "opencode",
    "claude",
    "codex"
  ],
  "author": "AionUI Team",
  "license": "MIT"
}
